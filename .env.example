# Webull OpenAPI credentials - generate at https://www.webull.com (developer portal)
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Your Webull account ID (find via get_account_list() after auth)
WEBULL_ACCOUNT_ID=your_account_id_here

# API environment: "uat" for paper/sandbox testing, "prod" for live trading
WEBULL_ENV=uat

# Region: "us" (only US supported in this bot)
WEBULL_REGION=us

# Token storage directory for 2FA (default: conf/token.txt)
# WEBULL_TOKEN_DIR=conf
